# ==============================================================================
# J.A.R.V.I.S Plus — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECURITY & ACCESS (Required)
# ------------------------------------------------------------------------------
# Security token required to access the HUD from browser (any string)
JARVIS_HUD_TOKEN=jarvis-plus-secret-token

# ------------------------------------------------------------------------------
# 2. DEFAULT ZERO-COST CLOUD TIER (Recommended Option A)
# ------------------------------------------------------------------------------
# Groq Whisper Cloud STT (Free tier: https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API for Brain & Multimodal TTS (Free tier: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Microsoft Edge-TTS requires ZERO API keys! It is 100% free with native accents.

# ------------------------------------------------------------------------------
# 3. NOUS HERMES AGENT BACKEND (Optional: for Autonomous Tools & Memory)
# ------------------------------------------------------------------------------
# If running Hermes Agent locally (https://github.com/NousResearch/hermes-agent)
API_SERVER_ENABLED=true
API_SERVER_KEY=your_hermes_api_server_key_here

# ------------------------------------------------------------------------------
# 4. PAID / CINEMATIC VOICE PROVIDERS (Optional: for Ultra-Realistic Speech)
# ------------------------------------------------------------------------------
# ElevenLabs Streaming Voice (https://elevenlabs.io)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Soniox Real-Time Low-Latency STT & TTS (https://soniox.com)
SONIOX_API_KEY=your_soniox_api_key_here

# ------------------------------------------------------------------------------
# 5. LOCAL OFFLINE TIER (Optional: 100% Private / No Cloud)
# ------------------------------------------------------------------------------
# If using Ollama locally: http://localhost:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
